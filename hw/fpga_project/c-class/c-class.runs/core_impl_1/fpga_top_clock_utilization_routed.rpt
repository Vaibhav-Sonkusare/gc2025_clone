set_property LOC BUFGCTRL_X0Y16 [get_cells mig_ddr3/u_mig_ddr3_mig/u_ddr3_infrastructure/u_bufg_clkdiv0]
set_property LOC BUFGCTRL_X0Y6 [get_cells clk_div/inst/clkf_buf]
