diff --git a/platform/cclass/ganga/objects.mk b/platform/cclass/ganga/objects.mk
new file mode 100644
index 00000000..41a1e8df
--- /dev/null
+++ b/platform/cclass/ganga/objects.mk
@@ -0,0 +1,37 @@
+#
+# SPDX-License-Identifier: BSD-2-Clause
+#
+# Copyright (c) 2019 Western Digital Corporation or its affiliates.
+# Copyright (c) 2024 Umesh .
+#
+
+# C Compiler and assembler flags.
+platform-cflags-y =
+platform-asflags-y =
+
+# Linker flags
+platform-ldflags-y =
+
+# Platform RISC-V XLEN, ABI, ISA and Code Model configuration.
+PLATFORM_RISCV_XLEN = 32
+PLATFORM_RISCV_ISA = rv$(PLATFORM_RISCV_XLEN)imafdc_zicsr_zifencei
+
+# Space separated list of object file names to be compiled for the platform
+platform-objs-y += platform.o
+
+#
+# Firmware with payload configuration.
+# This bundles OpenSBI and your next-stage bootloader/kernel into a single file.
+#
+FW_PAYLOAD=y
+
+# The payload (e.g., U-Boot, Linux) will be linked at an offset
+# from the start of OpenSBI. The default of 0x200000 is fine for rv64.
+ifeq ($(PLATFORM_RISCV_XLEN), 32)
+FW_PAYLOAD_OFFSET=0x400000
+else
+FW_PAYLOAD_OFFSET=0x200000
+endif
+
+# You will specify the actual payload binary during the make command, like:
+# FW_PAYLOAD_PATH="/path/to/your/u-boot.bin"
diff --git a/platform/cclass/ganga/platform.c b/platform/cclass/ganga/platform.c
new file mode 100644
index 00000000..5c74d5fb
--- /dev/null
+++ b/platform/cclass/ganga/platform.c
@@ -0,0 +1,159 @@
+/*
+ * SPDX-License-Identifier: BSD-2-Clause
+ *
+ * Copyright (c) 2019 Western Digital Corporation or its affiliates.
+ * Copyright (c) 2024 Umesh .
+ */
+
+#include <sbi/riscv_asm.h>
+#include <sbi/riscv_encoding.h>
+#include <sbi/sbi_const.h>
+#include <sbi/sbi_platform.h>
+#include <sbi_utils/ipi/aclint_mswi.h>
+#include <sbi_utils/irqchip/plic.h>
+#include <sbi_utils/timer/aclint_mtimer.h>
+#include <sbi_utils/serial/shakti-uart.h>
+
+
+/*
+ * Platform-specific Definitions for Ganaga
+ */
+
+// From 'MemoryBase'
+#define GANGA_MEMORY_ADDR			0x80000000
+
+// From 'PLICBase'
+#define GANGA_PLIC_ADDR				0x0C000000
+#define GANGA_PLIC_SIZE				(0x400000 + (GANGA_HART_COUNT * 0x2000))
+#define GANGA_PLIC_NUM_SOURCES		128
+
+// From 'ClintBase'
+#define GANGA_CLINT_ADDR			0x02000000
+#define GANGA_ACLINT_MTIMER_FREQ	10000000
+
+// From 'UARTxBase'
+#define GANGA_UART0_ADDR			0x00011300
+#define GANGA_UART1_ADDR			0x00011400
+#define GANGA_UART2_ADDR			0x00011500
+#define GANGA_UART_INPUT_FREQ		        50000000
+#define GANGA_UART_BAUDRATE			115200
+
+// From 'SPIxBase'
+#define GANGA_SPI0_ADDR				0x00020000
+#define GANGA_SPI1_ADDR				0x00020100
+
+// From 'I2CxBase'
+#define GANGA_I2C0_ADDR				0x00040000
+#define GANGA_I2C1_ADDR				0x00041400
+
+// From 'GPIOBase'
+#define GANGA_GPIO_ADDR				0x00040100
+
+// From 'GPTimerxBase'
+#define GANGA_GPTIMER0_ADDR			0x00040200
+#define GANGA_GPTIMER1_ADDR			0x00040300
+
+// HART Count
+#define GANGA_HART_COUNT			1
+
+// Derived Addresses (These typically don't need changes)
+#define GANGA_ACLINT_MSWI_ADDR		(GANGA_CLINT_ADDR + CLINT_MSWI_OFFSET)
+#define GANGA_ACLINT_MTIMER_ADDR	(GANGA_CLINT_ADDR + CLINT_MTIMER_OFFSET)
+
+/*static struct plic_data plic = {
+	.addr = GANGA_PLIC_ADDR,
+	.size = GANGA_PLIC_SIZE,
+	.num_src = GANGA_PLIC_NUM_SOURCES,
+	.context_map = {
+		[0] = { 0, 1 },// Context map for the single HART (HART 0) 
+	},
+};
+*/
+static struct aclint_mswi_data mswi = {
+	.addr = GANGA_ACLINT_MSWI_ADDR,
+	.size = ACLINT_MSWI_SIZE,
+	.first_hartid = 0,
+	.hart_count = GANGA_HART_COUNT,
+};
+
+static struct aclint_mtimer_data mtimer = {
+	.mtime_freq = GANGA_ACLINT_MTIMER_FREQ,
+	.mtime_addr = GANGA_ACLINT_MTIMER_ADDR +
+		      ACLINT_DEFAULT_MTIME_OFFSET,
+	.mtime_size = ACLINT_DEFAULT_MTIME_SIZE,
+	.mtimecmp_addr = GANGA_ACLINT_MTIMER_ADDR +
+			 ACLINT_DEFAULT_MTIMECMP_OFFSET,
+	.mtimecmp_size = ACLINT_DEFAULT_MTIMECMP_SIZE,
+	.first_hartid = 0,
+	.hart_count = GANGA_HART_COUNT,
+	.has_64bit_mmio = true,
+};
+
+/*
+ * Platform early initialization.
+ */
+static int ganga_early_init(bool cold_boot)
+{
+	if (!cold_boot)
+		return 0;
+
+        return shakti_uart_init(GANGA_UART0_ADDR, GANGA_UART_INPUT_FREQ, GANGA_UART_BAUDRATE);
+}
+
+/*
+ * Platform final initialization.
+ */
+static int ganga_final_init(bool cold_boot)
+{
+	return 0;
+}
+
+/*
+ * Initialize the platform interrupt controller during cold boot.
+ */
+/*static int ganga_irqchip_init(void)
+{
+	 Example if the generic PLIC driver is used 
+	return plic_cold_irqchip_init(&plic);
+}
+*/
+/*
+ * Initialize IPI during cold boot.
+ */
+static int ganga_ipi_init(void)
+{
+	/* Example if the generic ACLINT driver is used */
+	return aclint_mswi_cold_init(&mswi);
+}
+
+/*
+ * Initialize platform timer during cold boot.
+ */
+static int ganga_timer_init(void)
+{
+	/* Example if the generic ACLINT driver is used */
+	return aclint_mtimer_cold_init(&mtimer, NULL);
+}
+
+/*
+ * Platform descriptor.
+ */
+const struct sbi_platform_operations platform_ops = {
+	.early_init		= ganga_early_init,
+	.final_init		= ganga_final_init,
+//	.irqchip_init	= ganga_irqchip_init,
+	.ipi_init		= ganga_ipi_init,
+	.timer_init		= ganga_timer_init
+};
+
+const struct sbi_platform platform = {
+	.opensbi_version	= OPENSBI_VERSION,
+	.platform_version	= SBI_PLATFORM_VERSION(0x0, 0x01),
+	.name			    = "C-Class Ganaga",
+	.features		    = SBI_PLATFORM_DEFAULT_FEATURES,
+	.hart_count		    = GANGA_HART_COUNT,
+	.hart_stack_size	= SBI_PLATFORM_DEFAULT_HART_STACK_SIZE,
+	.heap_size		    = SBI_PLATFORM_DEFAULT_HEAP_SIZE(GANGA_HART_COUNT),
+	.platform_ops_addr	= (unsigned long)&platform_ops
+};
+
